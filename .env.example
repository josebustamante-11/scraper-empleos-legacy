# ─────────────────────────────────────────────────────
# .env.example — Copiá este archivo como .env y completá
# los valores reales. El .env NUNCA se sube al repo.
# ─────────────────────────────────────────────────────

# URL de la página que querés scrapear
SCRAPING_TARGET_URL=https://ejemplo.com/noticias
SCRAPING_VERIFY_SSL=false

# PostgreSQL — Supabase
# Obtenelo en: supabase.com → Tu proyecto → Settings → Database → URI
# DB_URL_POOLER=postgresql://postgres:[TU-PASSWORD]@db.[TU-REF].supabase.co:5432/postgres
DB_URL_POOLER=postgresql://postgres:[YOUR-PASSWORD]@db.vuljhegvhiazbkfqhayu.supabase.co:5432/postgres

# WordPress
WP_CACHE_DUMP=true
WP_URL=https://tu-sitio-wordpress.com
WP_USER=tu_usuario_wordpress
# Application Password — WP Admin → Usuarios → Tu perfil → Contraseñas de aplicación
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Telegram (opcional)
# Si TELEGRAM_ENABLED=true se enviarán avisos solo en eventos importantes.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_tu_token_de_bot
TELEGRAM_CHAT_ID=-1001234567890